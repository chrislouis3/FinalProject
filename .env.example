# .env - Environment Configuration (SECURE DEFAULTS)
# =======================================================
# Copy this file to .env and adjust as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Database
DATABASE_URL=sqlite:///instance/grades.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Logging
LOG_LEVEL=INFO
